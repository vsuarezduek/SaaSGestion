# Copiar a .env (nunca subir .env al repositorio).
# Base de datos local de desarrollo:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saasgestion

# Aplicación (apps/panel). Fuera de Vercel se usa DATABASE_URL_LOCAL:
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/saasgestion
# En Vercel (se cargan en el panel de Vercel como Secret, nunca acá):
#   DATABASE_URL_STAGING  → rama "staging" de Neon, entornos Preview y Development
#   DATABASE_URL          → rama "main" de Neon, solo Production (reservada)
